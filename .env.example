# Sals3 Admin Portal environment template.
#
# Variable NAMES only - never commit a real value. Copy to `.env.local` and
# fill in locally.
#
# This bootstrap build reads NONE of these yet. They are listed so the next
# slice's required configuration is visible before it is written, and so no
# secret is ever invented at implementation time.

# --- Admin Portal's own database (Gate 0: separate from sals3-portal) ---
# Postgres connection string. Admin Portal owns employee identity,
# permissions, policy versions, approvals, and admin audit here. It must NOT
# point at the sals3-portal database.
DATABASE_URL=

# --- Employee authentication (next slice, not implemented) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Policy publication to sals3-portal (next slice, not implemented) ---
# Server-only shared secret the Portal presents when pulling published
# platform policy. Follows the existing sals3-portal pattern
# (SALS3_STOREFRONT_API_TOKEN / DISCOVERY_CONTROL_SECRET): bearer token,
# constant-time comparison, fail closed when unset.
ADMIN_POLICY_PUBLICATION_TOKEN=
