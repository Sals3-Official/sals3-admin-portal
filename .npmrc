# eslint-config-airbnb@19 declares a peer range of eslint ^7 || ^8 and has not
# shipped an ESLint 9 release. The flat config in eslint.config.mjs adapts it
# through @eslint/compat + @eslint/eslintrc, which is why the rules work
# despite the stale peer declaration. Same setting, same reason, as
# sals3-portal - keep the two repositories in step.
legacy-peer-deps=true
